#!/bin/bash
# ==================================================
# Prokka Job Script for Hazel HPC
# ==================================================
# This script runs Prokka for viral protein annotation
# using an Apptainer Container


# --------------------------------------------------
# Request resources here
# --------------------------------------------------
#BSUB -J prokka                       # job name
#BSUB -n 2                            # number of CPUs required per task
#BSUB -q shared_memory                # the queue to run on
#BSUB -R "span[hosts=1]"              # number of hosts to spread the jobs across, 1 host used here
#BSUB -R "rusage[mem=4GB]"            # required total memory for the job 
#BSUB -o "./output.%J.log"            # standard output file (%J is job name)
#BSUB -e "./error.%J.log"             # standard error file (%J is job ID)
#BSUB -W 10:00:00                     # time to run

# --------------------------------------------------
# Load modules here
# --------------------------------------------------

module load apptainer

# --------------------------------------------------
# Execute commands here
# --------------------------------------------------

# Print job start information
echo "=================================================="
echo "Job started: $(date)"
echo "Job ID: $LSB_JOBID"
echo "Running on host: $(hostname)"
echo "Working directory: $(pwd)"
echo "=================================================="

# Source config file and get sample name from input list based on job array index
source ./config.sh
export SAMPLE=`head -n +${LSB_JOBINDEX} $IN_LIST | tail -n 1`


# --------------------------------------------------
# Validate inputs
# --------------------------------------------------

# Check if container exists
if [ ! -f "${PROKKA_SIF}" ]; then
    echo "ERROR: Container not found at ${PROKKA_SIF}"
    exit 1
fi

# Check if input directory exists
if [ ! -d "${IN_DIR}" ]; then
    echo "ERROR: Input directory not found at ${IN_DIR}"
    exit 1
fi

# --------------------------------------------------
# Execute Prokka
# --------------------------------------------------

echo "Running Prokka on sample: ${SAMPLE}"

apptainer exec ${PROKKA_SIF} prokka \
    --outdir "${OUT_DIR}/${SAMPLE}_prokka_output" \
    --prefix "${SAMPLE}_prokka" \
    --cpus 2 \                                   # number of CPUs, make sure it matches the -n value above
    --kingdom Viruses \
    --addgenes \
    --force \
    "${IN_DIR}/${SAMPLE}_checkv_output/${SAMPLE}_checkv_complete.fasta"

# Check if Prokka completed successfully
if [ $? -eq 0 ]; then
    echo "Prokka completed successfully"
else
    echo "ERROR: Prokka failed with exit code $?"
    exit 1
fi

# --------------------------------------------------
# Job completion
# --------------------------------------------------

echo "=================================================="
echo "Job completed: $(date)"
echo "Results saved to: ${OUT_DIR}"
echo "=================================================="